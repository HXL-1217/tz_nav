Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
        - /OccupiedMap1
        - /TraversableMap1
        - /StairMap1
        - /StairEndpoints1
        - /PlannedPath1
        - /PlannedPathMarker1
        - /SmoothedPath1
        - /SmoothedPathMarker1
      Splitter Ratio: 0.5
    Tree Height: 500
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 100; 100; 100
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
      Value: true
    # 1) 体素占据地图 (MarkerArray)
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: OccupiedMap
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /occupied_map
      Value: true
    # 1b) 可通行区域 (MarkerArray, alpha=1.0 完全不透明)
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: TraversableMap
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /traversable_map
      Value: true
    # 1c) 楼梯踏面格(橙色立方体) + 走向箭头(红色) (MarkerArray)
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: StairMap
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /stair_map
      Value: true
    # 1d) 楼梯端点(找的点: 绿=起始端/顶, 红=结束端/底) (MarkerArray), 与楼梯格显示分开
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: StairEndpoints
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /stair_endpoints
      Value: true
    # 2) 原始A*路径 (平滑前)
    #   2a) Path 话题 (nav_msgs/Path): /planned_path
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 242; 140; 26
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Lines
      Line Width: 0.03
      Name: PlannedPath
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 25; 0
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /planned_path
      Value: true
    #   2b) 原始A*路径粗线条 (Marker, LINE_STRIP, 橙色): /planned_path_marker
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: PlannedPathMarker
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /planned_path_marker
      Value: true
    # 3) 平滑后路径
    #   3a) Path 话题 (nav_msgs/Path): /smoothed_path
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 82; 41; 158
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.2
      Length: 0.3
      Line Style: Lines
      Line Width: 0.03
      Name: SmoothedPath
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Color: 255; 25; 0
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.1
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /smoothed_path
      Value: true
    #   3b) 平滑后路径粗线条 (Marker, LINE_STRIP, 深紫色): /smoothed_path_marker
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: SmoothedPathMarker
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /smoothed_path_marker
      Value: true
    # 4) 起点 (Marker, SPHERE, 绿色)
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: StartMarker
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /start_marker
      Value: true
    # 5) 终点 (Marker, SPHERE, 红色)
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: GoalMarker
      Namespaces:
        {}
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_marker
      Value: true
    # 6) 坐标系 (TF): 显示 map / base_link 等 frame 的 xyz 轴 (X红 Y绿 Z蓝)
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.3
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    # 用 Publish Point 点击下发起点(第1下)与终点(第2下)
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /clicked_point
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /goal_pose
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 45
      Focal Point:
        X: -3
        Y: 1.5
        Z: 2
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.785398
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.785398
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 846
  Hide Left Dock: false
  Hide Right Dock: false
  Width: 1200
  X: 60
  Y: 60
